NUTRIENT_LICENSE_KEY=
ALLOWED_ORIGINS=http://localhost:3000
PORT=8080
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Structured extraction (/api/extraction/structured) ---
# provider=openai uses OPENAI_API_KEY above. The other providers:
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
# --- AWS Bedrock (structured extraction) ---
# A LONG-TERM Bedrock API key. A short-term token expires in <=12 hours, which
# would break the Railway-hosted demo daily. Bearer auth replaces SigV4, so
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are NOT used by this path.
BEDROCK_API_KEY=
# Optional. Defaults to https://bedrock-mantle.$AWS_REGION.api.aws/v1
# MUST end in /v1 — the SDK appends /chat/completions verbatim.
BEDROCK_ENDPOINT=
# Optional. Default model when the request omits one.
BEDROCK_STRUCTURED_MODEL=qwen.qwen3-vl-235b-a22b

# Set LOCALLY ONLY. Its presence is what lists the "Local (LM Studio)" provider
# in the studio UI, so leaving it unset in Railway hides an option that cannot
# work there.
LM_STUDIO_API_URL=http://localhost:1234/v1
# Model overrides, so a demo can follow a new model without a code change.
# Defaults: gpt-5.4 (openai, azure), local-model (local).
# OPENAI_STRUCTURED_MODEL=
# AZURE_STRUCTURED_MODEL=
# LM_STUDIO_MODEL=
